// AI 업무 과제 연습실 작업 공간 (GitHub Codespaces 에서 열린다)
{
  "name": "AI 업무 과제 연습실",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "hostRequirements": {
    "cpus": 2
  },
  "containerEnv": {
    "TZ": "Asia/Seoul",
    "LANG": "C.UTF-8"
  },
  // practice CLI 와 Codex 를 설치하고, 셸 기록이 바로 파일에 남게 한다
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // 작업 공간이 멈췄다 다시 켜지면 뒤에서 도는 지켜보는 프로그램이 사라진다. 켜질 때마다 status 를 한 번 불러 다시 켠다(시작 전이면 아무 일도 안 한다).
  // status 는 지켜보는 프로그램을 먼저 켠 뒤에 서버 상태를 묻는다. 서버가 느려 45초에 끊겨도 되살리기는 이미 끝나 있다
  "postStartCommand": "timeout 45 practice status >/dev/null 2>&1 || true",
  "forwardPorts": [3000, 5173, 8000, 8080],
  // 실제 2차는 IDE 안의 Browser 도구로 띄운 서버를 본다. 여기서는 VS Code 안 미리보기 창이 그 자리다
  "portsAttributes": {
    "3000": { "label": "미리보기 3000", "onAutoForward": "openPreview" },
    "5173": { "label": "미리보기 5173", "onAutoForward": "openPreview" },
    "8000": { "label": "미리보기 8000", "onAutoForward": "openPreview" },
    "8080": { "label": "미리보기 8080", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["MS-CEINTL.vscode-language-pack-ko"],
      "settings": {
        "workbench.startupEditor": "none",
        "workbench.panel.defaultLocation": "bottom",
        "editor.minimap.enabled": false,
        "editor.wordWrap": "on",
        "editor.unicodeHighlight.nonBasicASCII": false,
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "files.autoSave": "off",
        "terminal.integrated.defaultLocation": "view",
        // 과제 파일은 모두 assignment 폴더에 풀린다. 터미널이 저장소 맨 위에서 열리면 npm 이 package.json 을 못 찾고 결과물이 제출 폴더 밖에 생긴다
        "terminal.integrated.cwd": "${workspaceFolder}/assignment",
        // assignment 는 .gitignore 에 들어 있어 기본 설정으로는 검색에서 빠진다. 사전 체험의 돋보기 검색이 비지 않게 한다
        "search.useIgnoreFiles": false,
        "terminal.integrated.fontSize": 14,
        "explorer.confirmDelete": false,
        "telemetry.telemetryLevel": "off",
        // VS Code 에 들어 있는 Copilot 안내(GitHub 로그인 · AI 기능)를 숨긴다. 2차는 Codex 만 쓰는데, 10/27 손님이 이 안내를 보고 AI 를 못 쓴다고 문의했다
        "chat.disableAIFeatures": true
      }
    }
  }
}
